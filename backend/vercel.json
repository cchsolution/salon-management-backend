{
  "version": 2,
  "builds": [
    {
      "src": "salon_core/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "apps/**",
          "salon_core/**",
          "templates/**",
          "requirements.txt"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "salon_core/wsgi.py"
    }
  ]
}

# ========================================================
# LuxeSalon SaaS - Backend Environment Configuration Example
# ========================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# On Render (or other production hosts), configure these
# as Environment Variables in the service settings dashboard.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ========================================================

# Django Secret Key (generate a cryptographically secure key for production)
DJANGO_SECRET_KEY=

# Set to False in production
DJANGO_DEBUG=False

# PostgreSQL Connection String (e.g., Neon, Supabase, Render PostgreSQL)
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=

# Comma-separated list of allowed hostnames (e.g. your-app.onrender.com,localhost,127.0.0.1)
# Note: RENDER_EXTERNAL_HOSTNAME is automatically detected on Render
ALLOWED_HOSTS=

# Comma-separated list of allowed CORS origins for the frontend
# (e.g. https://your-frontend.vercel.app,http://localhost:5173)
CORS_ALLOWED_ORIGINS=

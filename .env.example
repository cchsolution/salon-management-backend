# ========================================================
# Salon Management SaaS - Backend Environment Configuration Example
# ========================================================
# For local development:
#   Copy this file to .env inside the backend/ folder:
#   cp .env.example backend/.env
#
# On Vercel:
#   Configure these variables in your Vercel Project Settings:
#   Project Dashboard -> Settings -> Environment Variables.
#
# DO NOT COMMIT REAL SECRETS, PASSWORDS, OR .env TO GIT.
# ========================================================

# Django Secret Key (generate a cryptographically secure key for production)
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-vercel-key-2026

# Set to False in production
DJANGO_DEBUG=False

# Neon PostgreSQL Connection String (pooled connection recommended for serverless)
# Format: postgresql://<user>:<password>@<neon-host>/<dbname>?sslmode=require
DATABASE_URL=

# Comma-separated list of allowed hostnames
# Note: .vercel.app, localhost, and VERCEL_URL are automatically allowed by default
ALLOWED_HOSTS=

# Comma-separated list of allowed CORS origins for the frontend
# (e.g., https://salon-management-three.vercel.app,http://localhost:5173)
CORS_ALLOWED_ORIGINS=https://salon-management-three.vercel.app,http://localhost:5173

# Comma-separated list of trusted origins for CSRF
CSRF_TRUSTED_ORIGINS=https://salon-management-three.vercel.app,https://*.vercel.app
